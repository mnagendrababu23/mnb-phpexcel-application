{
    "name": "mnb/mnb-phpexcel-application",
    "description": "Facade, workbook builder, application helpers, plugins, diagnostics, and full workflow API for MNB PHPExcel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "mnb/mnb-phpexcel-core": "^2.0",
        "mnb/mnb-phpexcel-csv": "^2.0",
        "mnb/mnb-phpexcel-json": "^2.0",
        "mnb/mnb-phpexcel-xml": "^2.0",
        "mnb/mnb-phpexcel-xlsx": "^2.0",
        "mnb/mnb-phpexcel-ods": "^2.0",
        "mnb/mnb-phpexcel-xls": "^2.0",
        "mnb/mnb-phpexcel-database": "^2.0",
        "mnb/mnb-phpexcel-database-xlsx": "^2.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mnb\\PHPExcel\\": "src/"
        }
    },
    "conflict": {
        "mnb/mnb-phpexcel": "*"
    }
}
